# SAMS - Smart Audit Management System
# ZAInnovate Technologies (Pty) Ltd - East London, South Africa

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://sams_admin:secure_password@localhost:5432/zainnovate_sams?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-robust-random-secret-key-min-32-chars"

# SAMS AI Engine API Keys & Service Endpoints
SAMS_AI_INFERENCE_URL="http://localhost:8000/v1"
SAMS_AI_SERVICE_KEY="sams_dev_sec_key_rsa"

# South African Government API Integrations (Staging / Mock)
SARS_TAX_COMPLIANCE_ENDPOINT="https://staging.sars.gov.za/tcs/verify"
CIPC_ENTERPRISE_API_URL="https://staging.cipc.co.za/services"
PERSAL_VERIFICATION_PROXY="https://mock.treasury.gov.za/persal"

# Telemetry & Compliance Logging
LOG_LEVEL="debug"
NODE_ENV="development"
ENABLE_POPIA_AUDIT_LOG="true"
